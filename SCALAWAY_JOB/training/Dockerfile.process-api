# syntax=docker/dockerfile:1
# Job 3v2 – Process API Model Training
# Build context: SCALAWAY_JOB/  (docker build -f training/Dockerfile.process-api .)
#
# Same deps as training:stats-api.
# Entry point is main_v2.py: trains all 4 targets and exports clean .pkl artifacts.

FROM ghcr.io/astral-sh/uv:python3.11-bookworm-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# --- System dependencies (proj-bin for pyproj spatial blocking) ---
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        tini \
        proj-bin \
        libproj-dev \
    ; \
    rm -rf /var/lib/apt/lists/*

# --- Install Python dependencies ---
COPY training/pyproject.toml /app/
RUN uv pip install --system $(python -c "import tomllib; d=tomllib.load(open('pyproject.toml','rb')); print(' '.join(d['project']['dependencies']))")

# --- Copy job code (includes main_v2.py + soil_texture_pipeline_v2.py) ---
COPY training/ /app/

# At runtime, mount:
#   feature_store/output/features_v2.parquet → /data/features_v2.parquet (read-only)
#   filter_config.json                        → /data/filter_config.json  (read-only)
#   DSM_WEBAPP/models/                        → /models                   (read-write)
#   training/reports/                         → /reports                  (read-write)

# --- Non-root user ---
RUN useradd -m -u 10001 appuser && chown -R appuser:appuser /app
USER appuser

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "main_v2.py", "--help"]
