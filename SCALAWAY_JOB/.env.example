# =============================================================================
# sentinel-soil pipeline — environment variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Local dev (MinIO):  use the LOCAL DEV section as-is (no changes needed)
# Cloud (Scaleway):   replace the OBJECT STORAGE section with real credentials
# =============================================================================


# -----------------------------------------------------------------------------
# Sentinel Hub / Copernicus CDSE  (required for Job 1 – ingestion)
# Get credentials at: https://shapps.dataspace.copernicus.eu/dashboard/#/
# -----------------------------------------------------------------------------
SH_CLIENT_ID=your_sh_client_id_here
SH_CLIENT_SECRET=your_sh_client_secret_here


# -----------------------------------------------------------------------------
# Object Storage — LOCAL DEV (MinIO, works out of the box with docker compose)
# -----------------------------------------------------------------------------
# Inside Docker network (docker compose):
SCALEWAY_S3_ENDPOINT=http://minio:9000
# Outside Docker (uv run ... from host):
# SCALEWAY_S3_ENDPOINT=http://localhost:9000

SCALEWAY_S3_REGION=us-east-1
SCALEWAY_S3_BUCKET=soil-sentinel
SCALEWAY_ACCESS_KEY=minioadmin
SCALEWAY_SECRET_KEY=minioadmin


# -----------------------------------------------------------------------------
# Object Storage — CLOUD (Scaleway Object Storage)
# Replace all 5 vars above with these when deploying to Scaleway:
# -----------------------------------------------------------------------------
# SCALEWAY_S3_ENDPOINT=https://s3.fr-par.scw.cloud
# SCALEWAY_S3_REGION=fr-par
# SCALEWAY_S3_BUCKET=your-bucket-name
# SCALEWAY_ACCESS_KEY=your_scaleway_access_key
# SCALEWAY_SECRET_KEY=your_scaleway_secret_key


# -----------------------------------------------------------------------------
# Job 2 – Feature Store
# -----------------------------------------------------------------------------
FEATURE_STORE_PREFIX=batch_results/aggregated/
LABELS_PATH=/data/gabri_filters.xlsx
OUTPUT_PATH=/output/features.parquet


# -----------------------------------------------------------------------------
# Job 3 – Training knobs
# -----------------------------------------------------------------------------
TARGET=Clay
PIPELINE_VERSION=v2
