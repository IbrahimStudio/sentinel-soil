# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your values.
# ---------------------------------------------------------------------------

# Absolute path to the repo root on YOUR machine (used by DockerOperator for
# volume mounts — the path must be valid on the Docker host, not inside a container)
HOST_REPO_PATH=/absolute/path/to/sentinel-soil

# Airflow security keys — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=change-me-to-a-random-string

# Sentinel Hub Statistics API
SH_CLIENT_ID=
SH_CLIENT_SECRET=

# Object storage — set to MinIO values for local runs, Scaleway values for production
SCALEWAY_S3_ENDPOINT=http://minio:9000          # local (MinIO); change for Scaleway
SCALEWAY_S3_REGION=fr-par
SCALEWAY_S3_BUCKET=soil-sentinel
SCALEWAY_ACCESS_KEY=minioadmin                  # local; change for Scaleway
SCALEWAY_SECRET_KEY=minioadmin                  # local; change for Scaleway
