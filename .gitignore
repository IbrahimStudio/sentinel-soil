# -----------------------
# Python / Packaging
# -----------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/
*.whl

# -----------------------
# Virtual environments
# -----------------------
.venv/
venv/
env/
ENV/

# -----------------------
# IDE / Editor files
# -----------------------
.vscode/
.idea/
*.swp
*.swo

# -----------------------
# OS files
# -----------------------
.DS_Store
Thumbs.db

# -----------------------
# Project-specific ignores
# -----------------------

# Local configuration (contains paths, AOI name, credentials placeholders)
configs/*.local.yaml
configs/*secret*.yaml
configs/*

# If using .env files for credentials
.env
.env.*
!.env.example
!SCALAWAY_JOB/.env.example
vm.env
SCALAWAY_JOB/vm.env

# -----------------------
# SCALAWAY_JOB outputs (keep dir skeleton via .gitkeep)
# -----------------------

# ML run reports (regenerable)
SCALAWAY_JOB/training/reports/*/
SCALAWAY_JOB/training/reports/*.csv
SCALAWAY_JOB/training/reports/*.png

# Analysis outputs
SCALAWAY_JOB/analysis_scl_ndvi.csv
SCALAWAY_JOB/analysis_scl_ndvi_plots/*
SCALAWAY_JOB/analysis_scl_plots/*

# Coverage outputs
SCALAWAY_JOB/coverage_out/*

# MinIO local S3 data (docker compose --profile local)
SCALAWAY_JOB/local_storage/
AIRFLOW_JOB/local_storage/

# Intermediate feature tables and result files
SCALAWAY_JOB/*.xlsx
SCALAWAY_JOB/*.csv
SCALAWAY_JOB/*.json
!SCALAWAY_JOB/gabri_filters.xlsx

# Sklearn model binaries
*.joblib

# Excel temp lock files
~$*

# DSM_WEBAPP — generated model artifacts (keep directory skeleton via .gitkeep)
DSM_WEBAPP/models/*.pkl
DSM_WEBAPP/models/*.json
DSM_WEBAPP/models/VERSION

# Claude Code local settings
.claude/

# Understand-anything tool artifacts
.understand-anything/

# Always track skeleton markers
!**/.gitkeep

# -----------------------
# Raster Data
# -----------------------
data/raw/
data/indices/
data/metadata/
data/

# If using intermediate cubes or numpy arrays
*.npy
*.npz
*.zarr/
*.h5

# Large Geospatial Files
*.tif
*.tiff
*.vrt
*.jp2
*.nc
*.parquet
*.cog.tif

# -----------------------
# Logs / Cache
# -----------------------
logs/
*.log
*.out
*.err
.cache/
tmp/
temp/
checkpoint/
checkpoints/

# -----------------------
# Jupyter Notebook junk
# -----------------------
.ipynb_checkpoints/
*.ipynb_edit*


configs\dev.yaml